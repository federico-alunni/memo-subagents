{
  "name": "pi-memo-subagents",
  "version": "0.4.9",
  "description": "Interactive pi subagents in Herdr: external agent definitions, pane selector, optional git worktrees",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Federico Alunni",
  "repository": {
    "type": "git",
    "url": "https://github.com/federico-alunni/pi-memo-subagents"
  },
  "type": "module",
  "bin": {
    "pi-subagent": "./bin/pi-subagent.mjs"
  },
  "exports": {
    ".": "./pi-extension/subagents/index.ts",
    "./client": "./pi-extension/subagents/client.ts",
    "./runtime": "./pi-extension/subagents/runtime/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "pi-extension",
    "config.json.example",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "provenance.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --import ./test/host-aliases.mjs --test test/*.test.ts test/test.ts test/*.test.mjs test/runtime/*.test.ts",
    "test:live": "node test/pane-selector-live.mjs && node --import ./test/host-aliases.mjs test/mirror-live.mjs && node --import ./test/host-aliases.mjs test/column-live.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.15"
  },
  "devDependencies": {
    "pi-memo-question": "git+https://github.com/federico-alunni/pi-memo-question.git#beta"
  }
}
